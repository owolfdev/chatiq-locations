# Service-to-service auth: ChatIQ adapter sends this as Bearer token
# (must match ChatIQ LOCATIONS_SIBLING_TOKEN)
LOCATIONS_SERVICE_TOKEN=dev-locations-service-token-change-me

# Dedicated Supabase project (see dev_docs/supabase-setup.md)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Vision extract (Phase 2 — mapper Process photos). See dev_docs/vision-extract-next.md
OPENAI_API_KEY=
# LOCATIONS_VISION_MODEL=gpt-5-mini

# Mapper survey uploads / Open mapper handoff (defaults to LOCATIONS_SERVICE_TOKEN)
# LOCATIONS_MAPPER_TOKEN=

# Vercel Cron for /api/cron/extract-tick (optional; mapper UI can also tick)
# CRON_SECRET=
